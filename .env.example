# Copy to .env.local and fill in. Never commit real values (CLAUDE.md).
# Master plan Section 15.2, plus the variables the code reads today.

# Absolute base URL: canonical links, hreflang, sitemap, RSS, QR on /id.
NEXT_PUBLIC_SITE_URL=
# Staging only: "true" sets noindex on every page and disallows all
# crawling in robots.txt (risk #11). Leave unset in production.
SITE_NOINDEX=

# --- No-database mode (Vercel deployment, docs/DECISIONS.md 2026-11-26) ---
# Leave every FIREBASE_* variable unset: content then comes from
# content/seed/*.json and the values below replace the Firestore settings.
# Never commit real values; set them in Vercel → Settings → Environment
# Variables.
DONATIONS_ENABLED=
JOIN_OPEN=
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP=
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_LINKEDIN=
BANK_HOLDER=
BANK_NAME=
BANK_RIB=
BANK_IBAN=
BANK_SWIFT=

# Firebase client SDK (only when using a database)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
ADMIN_SESSION_COOKIE_NAME=

# Local emulators (pnpm emulators); firebase.json puts Firestore on 8081
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Lets the admin login page sign in against the Auth emulator:
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Cloudflare Turnstile (forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Board notification email (contact, join, pledges)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
BOARD_NOTIFICATION_EMAIL=

# /api/revalidate shared secret
REVALIDATE_SECRET=

# Pledge amount limits in MAD (master plan Section 8.5)
PLEDGE_MIN_AMOUNT_MAD=
PLEDGE_MAX_AMOUNT_MAD=

# Stripe Checkout, TEST MODE ONLY (docs/DECISIONS.md). Unset = bank
# transfer only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=

# Cookie-less analytics (not wired yet, docs/BACKLOG.md)
NEXT_PUBLIC_ANALYTICS_TOKEN=
