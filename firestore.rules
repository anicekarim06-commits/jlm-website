rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isEditor() {
      return isSignedIn() && (role() == 'editor' || role() == 'admin');
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    // --- Public, editor-writable content ---

    match /poles/{poleId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /platforms/{platformId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /flagshipActions/{actionId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /team/{memberId} {
      allow read: if resource.data.consent == true;
      allow write: if isEditor();
    }

    match /posts/{postId} {
      allow read: if resource.data.published == true
        && resource.data.publishAt <= request.time
        && (!('expiresAt' in resource.data) || resource.data.expiresAt > request.time);
      allow read: if isEditor();
      allow write: if isEditor();
    }

    // --- Admin-only content ---

    match /campaigns/{campaignSlug} {
      allow read: if resource.data.published == true;
      allow read: if isEditor();
      // Admin only (master plan 5.1). An editor must not be able to change
      // goalMAD/receivedMAD and so fake a donation progress bar.
      allow write: if isAdmin();
    }

    match /partners/{partnerId} {
      allow read: if resource.data.published == true;
      allow read: if isEditor();
      allow write: if isAdmin();
    }

    match /settingsPublic/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin() || request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // --- Server-only: never readable or writable by any client ---

    match /pledges/{pledgeId} {
      allow read, write: if false;
    }

    match /contactMessages/{messageId} {
      allow read, write: if false;
    }

    match /joinRequests/{requestId} {
      allow read, write: if false;
    }
  }
}
