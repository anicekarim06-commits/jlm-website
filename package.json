{
  "name": "jlm-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:logical": "tsx scripts/check-logical-properties.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/unit/firestore.rules.test.ts\"",
    "e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "emulators": "firebase emulators:start --only firestore,auth,storage"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.36.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.18.0"
}
